{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "height": 18,
    "type": "builtin",
    "source": "arch"
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[36m    コンピューター",
      "outputColor": "cyan"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐",
      "outputColor": "cyan"
    },
    {
      "type": "os",
      "key": "   OS",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
    {
      "type": "packages",
      "key": "   Packages",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
    {
      "type": "display",
      "key": "   Display",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
    {
      "type": "wm",
      "key": "   WM",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
     {
      "type": "shell",
      "key": "   Shell",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘",
      "outputColor": "cyan"
    },
    "break",
    {
      "type": "title",
      "key": "  ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐",
      "outputColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "   CPU",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
    {
      "type": "gpu",
      "key": "   GPU",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
    {
      "type": "memory",
      "key": "  ﬙ Memory",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
    {
      "type": "battery",
      "key": "   Battery",
      "keyColor": "white",
      "outputColor": "bright_cyan",
      "percent": {
        "green": 80,
        "yellow": 30
      }
    },
    {
      "type": "uptime",
      "key": "   Uptime",
      "keyColor": "white",
      "outputColor": "bright_cyan"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘",
      "outputColor": "cyan"
    },
    "break"
  ]
}
